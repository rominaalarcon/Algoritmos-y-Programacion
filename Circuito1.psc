Algoritmo Circuito1
	Definir p, q Como Logico
	
	p <- Verdadero
	q <- Verdadero 
	Escribir  "p     q        p AND q        NOT q      (p AND q) OR (NOT q)"
	p <- Verdadero
	q <- Falso  
	Escribir p, "-",q,"-",p y q,"-",no q,"-", (p y q) or (no q) 
	p <- Falso
	q <- Verdadero 
	Escribir p, "-",q,"-",p y q,"-",no q,"-", (p y q) or (no q) 
	p <- Falso
	q <- Falso
	Escribir p, "-",q,"-",p y q,"-",no q,"-", (p y q) or (no q) 
	
	
	
FinAlgoritmo
